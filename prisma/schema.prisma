// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

// ================== USER ======================

model User {
  id        String   @id @default(uuid())

  username  String   @unique
  email     String   @unique
  password  String

  name      String?

  role      Role

  phone     String?
  address   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  // assignments
  studentAssignments     Assignment[] @relation("StudentAssignments")
  supervisorAssignments  Assignment[] @relation("SupervisorAssignments")

  // submissions
  studentSubmissions     Submission[] @relation("StudentSubmissions")
  supervisorSubmissions  Submission[] @relation("SupervisorSubmissions")
  opponentSubmissions    Submission[] @relation("OpponentSubmissions")
}

enum Role {
  STUDENT
  TEACHER
  GUEST
}

// ================== ASSIGNMENTS ======================

model Assignment {
  id            String   @id @default(uuid())

  topic         String   @unique
  type          Type

  annotation    String?

  faculty       Faculty
  department    Department

  // FK
  studentId     String
  supervisorId  String

  // RELATIONS
  student       User @relation("StudentAssignments", fields: [studentId], references: [id])
  supervisor    User @relation("SupervisorAssignments", fields: [supervisorId], references: [id])

  submissions   Submission[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignmentDate DateTime @default(now())
}

// ================== SUBMISSIONS  ======================

model Submission {
  id            String   @id @default(uuid())

  topic         String   @unique
  status        Status
  type          Type

  annotation    String?
  literature    String?

  faculty       Faculty
  department    Department

  // FK
  assignmentId  String

  studentId     String
  supervisorId  String
  opponentId    String

  // RELATIONS
  assignment    Assignment @relation(fields: [assignmentId], references: [id])

  student       User @relation("StudentSubmissions", fields: [studentId], references: [id])

  supervisor    User @relation("SupervisorSubmissions", fields: [supervisorId], references: [id])

  opponent      User @relation("OpponentSubmissions", fields: [opponentId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissionDate DateTime?
}

enum Status {
  PENDING
  COMPLETED
  IN_PROGRESS
}

enum Type {
  bachelor
  master
  phd
  other
}

enum Faculty {
  PRF
  CHEM
}

enum Department {
  Informatics
  Mathematics
  Physics
  Chemistry
}

