generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

// ================== USER ======================

model User {
  id String @id // set from Keycloak sub on first login

  username String @unique
  email    String @unique

  name String?

  role Role

  phone          String?
  address        String?
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentAssignments    Assignment[] @relation("StudentAssignments")
  supervisorAssignments Assignment[] @relation("SupervisorAssignments")

  opponentSubmissions Submission[] @relation("OpponentSubmissions")

  reviews       Review[]
  files         SubmissionFile[]
  notifications Notification[]
}

enum Role {
  STUDENT
  TEACHER
}

// ================== ASSIGNMENTS ======================

model Assignment {
  id String @id @default(uuid())

  topic String @unique
  type  Type

  annotation String?

  faculty    Faculty
  department Department

  taken Boolean @default(false)

  studentId    String?
  supervisorId String

  student    User? @relation("StudentAssignments", fields: [studentId], references: [id])
  supervisor User  @relation("SupervisorAssignments", fields: [supervisorId], references: [id])

  submissions Submission[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignmentDate DateTime @default(now())
}

// ================== SUBMISSIONS ======================

model Submission {
  id String @id @default(uuid())

  // Student-editable copy of assignment data
  topic      String
  type       Type
  faculty    Faculty
  department Department
  annotation String?

  status    Status
  literature String?
  fileUrl    String?

  submissionDate DateTime @default(now())

  assignmentId String
  opponentId   String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  opponent   User?      @relation("OpponentSubmissions", fields: [opponentId], references: [id])

  reviews Review[]
  files   SubmissionFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Status {
  PENDING
  COMPLETED
  IN_PROGRESS
  REJECTED
}

enum Type {
  bc
  mgr
  phd
  other
}

enum Faculty {
  PRF
  CHEM
}

enum Department {
  Informatics
  Mathematics
  Physics
  Chemistry
}

// ================== REVIEWS ======================

model Review {
  id String @id @default(uuid())

  grade   Grade
  comment String?
  type    ReviewType

  submissionId String
  reviewerId   String

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  files SubmissionFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, type])
}

enum Grade {
  A
  B
  C
  D
  E
  F
}

enum ReviewType {
  SUPERVISOR
  OPPONENT
}

// ================== FILES ======================

model SubmissionFile {
  id          String     @id @default(uuid())
  key         String     @unique
  filename    String
  contentType String
  size        Int?
  folder      FileFolder

  submissionId String
  reviewId     String?
  uploadedById String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  review     Review?    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FileFolder {
  REVIEWS
  TEXT
  FILES
}

// ================== NOTIFICATIONS ======================

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  message String
  read    Boolean          @default(false)

  entityType String?
  entityId   String?

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_SUBMITTED
  SUBMISSION_EDITED
  SUBMISSION_DELETED
  SUBMISSION_OPPONENT_ASSIGNED

  ASSIGNMENT_PICKED
  ASSIGNMENT_UNPICKED

  REVIEW_CREATED
  REVIEW_EDITED
  REVIEW_DELETED

  FILE_MAIN_UPLOADED
  FILE_ATTACHMENT_UPLOADED
  FILE_UPLOADED
  FILE_MAIN_EDITED
  FILE_ATTACHMENT_EDITED
  FILE_EDITED
  FILE_MAIN_DELETED
  FILE_ATTACHMENT_DELETED
  FILE_DELETED
}
