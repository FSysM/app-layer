generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

// ================== USER ======================

model User {
  id String @id // set from Keycloak sub on first login

  username String @unique
  email    String @unique

  name String?

  role Role

  phone          String?
  address        String?
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentAssignments    Assignment[] @relation("StudentAssignments")
  supervisorAssignments Assignment[] @relation("SupervisorAssignments")

  opponentSubmissions Submission[] @relation("OpponentSubmissions")

  reviews Review[]
}

enum Role {
  STUDENT
  TEACHER
}

// ================== ASSIGNMENTS ======================

model Assignment {
  id String @id @default(uuid())

  topic String @unique
  type  Type

  annotation String?

  faculty    Faculty
  department Department

  taken Boolean @default(false)

  studentId    String?
  supervisorId String

  student    User? @relation("StudentAssignments", fields: [studentId], references: [id])
  supervisor User  @relation("SupervisorAssignments", fields: [supervisorId], references: [id])

  submissions Submission[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignmentDate DateTime @default(now())
}

// ================== SUBMISSIONS ======================

model Submission {
  id String @id @default(uuid())

  // Student-editable copy of assignment data
  topic      String
  type       Type
  faculty    Faculty
  department Department
  annotation String?

  status    Status
  literature String?
  fileUrl    String?

  submissionDate DateTime @default(now())

  assignmentId String?
  opponentId   String?

  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  opponent   User?       @relation("OpponentSubmissions", fields: [opponentId], references: [id])

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Status {
  SUBMITTED
  APPROVED
  REVIEWING
  COMPLETED
  REJECTED
}

enum Type {
  bc
  mgr
  phd
  other
}

enum Faculty {
  PRF
  CHEM
}

enum Department {
  Informatics
  Mathematics
  Physics
  Chemistry
}

// ================== REVIEWS ======================

model Review {
  id String @id @default(uuid())

  grade   Grade
  comment String?
  type    ReviewType

  submissionId String
  reviewerId   String

  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, type])
}

enum Grade {
  A
  B
  C
  D
  E
  F
}

enum ReviewType {
  SUPERVISOR
  OPPONENT
}
