// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

// ================== USER ======================

model User {
  id        String   @id @default(uuid())

  username  String   @unique
  email     String   @unique
  password  String

  name      String?

  role      Role

  phone     String?
  address   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  studentTasks     Task[] @relation("StudentTasks")
  supervisorTasks  Task[] @relation("SupervisorTasks")
  opponentTasks    Task[] @relation("OpponentTasks")
}

enum Role {
  STUDENT
  TEACHER
  GUEST
}

// ================== TASKS ======================

model Task {
  id            String   @id @default(uuid())

  topic         String   @unique
  status        Status
  type          Type

  annotation    String?
  literature    String?

  faculty       Faculty
  department    Department

  // FOREIGN KEYS
  studentId     String
  supervisorId  String
  opponentId    String

  // RELATIONS
  student       User @relation("StudentTasks", fields: [studentId], references: [id])
  supervisor    User @relation("SupervisorTasks", fields: [supervisorId], references: [id])
  opponent      User @relation("OpponentTasks", fields: [opponentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissionDate DateTime?
  assignmentDate DateTime
}

enum Status {
  PENDING
  COMPLETED
  IN_PROGRESS
}

enum Type {
  bachelor
  master
  phd
  other
}

enum Faculty {
  PRF
  CHEM
}

enum Department {
  Informatics
  Mathematics
  Physics
  Chemistry
}

